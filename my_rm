#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_PATH="$(realpath -e -- "${BASH_SOURCE[0]}")"
MY_RM_PARTITION="${MY_RM_PARTITION:-cbuild}"
MY_RM_TIME="${MY_RM_TIME:-08:00:00}"
MY_RM_CPUS="${MY_RM_CPUS:-8}"
MY_RM_LOG_DIR="${MY_RM_LOG_DIR:-$(pwd -P)}"

usage() {
    cat <<'EOF'
Usage:
  ./my_rm [--dry-run] DIRECTORY

Resolve DIRECTORY to an absolute path and submit a Slurm job that scans its
full tree, chooses parallel batch sizes, removes files concurrently at any
depth, then removes directories after they are empty.

Options:
  --dry-run     Print the sbatch command without submitting or deleting.
  -h, --help    Show this help.

Environment:
  MY_RM_PARTITION=cbuild    Slurm partition.
  MY_RM_TIME=08:00:00       Slurm wall time.
  MY_RM_CPUS=8              Concurrent rm processes and allocated CPUs.
  MY_RM_LOG_DIR=$PWD        Directory for my_rm.<job-id>.log.
EOF
}

die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

safe_tag() {
    printf '%s' "$1" | sed 's/[^A-Za-z0-9_.-]/_/g'
}

validate_target() {
    local target="$1"
    local current_uid target_uid user_name

    [[ "$target" == /* ]] || die "Target must be an absolute path: $target"
    [[ -d "$target" ]] || die "Target directory does not exist: $target"
    [[ ! -L "$target" ]] || die "Refusing to remove a symbolic link: $target"

    user_name="${USER:-${LOGNAME:-}}"
    case "$target" in
        /|/bin|/boot|/dev|/etc|/home|/lib|/lib64|/opt|/proc|/root|/run|/sbin|/srv|/sys|/tmp|/usr|/var)
            die "Refusing to remove protected directory: $target"
            ;;
    esac
    if [[ -n "$user_name" ]]; then
        case "$target" in
            "/home/$user_name"|"/scratch-shared/$user_name"|"/scratch-shared/$user_name/qgpu_batch")
                die "Refusing to remove protected user root: $target"
                ;;
        esac
    fi
    [[ ! -d "$target/.git" ]] || die "Refusing to remove a Git repository root: $target"

    if command -v mountpoint >/dev/null 2>&1 && mountpoint -q -- "$target"; then
        die "Refusing to remove a mount point: $target"
    fi

    current_uid="$(id -u)"
    target_uid="$(stat -c '%u' -- "$target")"
    [[ "$target_uid" == "$current_uid" ]] || \
        die "Target is not owned by uid $current_uid: $target"
}

print_command() {
    printf '%q ' "$@"
    printf '\n'
}

worker_main() {
    local requested="$1"
    local target workers scan_counts non_dirs dirs desired_tasks
    local file_batch dir_batch

    [[ -n "${SLURM_JOB_ID:-}" ]] || die "Worker mode may run only inside a Slurm job"
    [[ -d "$requested" ]] || die "Target disappeared before cleanup started: $requested"
    [[ ! -L "$requested" ]] || die "Target became a symbolic link: $requested"
    target="$(realpath -e -- "$requested")"
    [[ "$target" == "$requested" ]] || \
        die "Target path changed before cleanup: requested=$requested resolved=$target"
    validate_target "$target"

    workers="${SLURM_CPUS_PER_TASK:-$MY_RM_CPUS}"
    [[ "$workers" =~ ^[1-9][0-9]*$ ]] || die "Invalid worker count: $workers"

    printf '[%s] Scanning directory tree: %s\n' "$(date -Iseconds)" "$target"
    scan_counts="$(
        find "$target" -xdev -mindepth 1 -printf '%y\n' |
            awk '
                $1 == "d" { dirs++ }
                $1 != "d" { non_dirs++ }
                END { printf "%d %d", non_dirs + 0, dirs + 0 }
            '
    )"
    read -r non_dirs dirs <<< "$scan_counts"

    # Aim for several batches per worker so uneven file sizes do not leave
    # CPUs idle. Caps avoid excessively large rm/rmdir argument lists.
    desired_tasks=$((workers * 16))
    file_batch=$(((non_dirs + desired_tasks - 1) / desired_tasks))
    dir_batch=$(((dirs + desired_tasks - 1) / desired_tasks))
    ((file_batch >= 1)) || file_batch=1
    ((dir_batch >= 1)) || dir_batch=1
    ((file_batch <= 512)) || file_batch=512
    ((dir_batch <= 64)) || dir_batch=64

    printf '[%s] Tree contains %s non-directory entries and %s directories; workers=%s file_batch=%s dir_batch=%s\n' \
        "$(date -Iseconds)" "$non_dirs" "$dirs" "$workers" "$file_batch" "$dir_batch"

    if ((non_dirs > 0)); then
        find "$target" -xdev -mindepth 1 ! -type d -print0 |
            xargs -0 -r -n "$file_batch" -P "$workers" rm -f --
    fi

    if ((dirs > 0)); then
        # The depth-first stream usually gives rmdir children before parents.
        # Parallel execution can race a parent with its child, so non-empty
        # failures are ignored and a final depth-first pass removes leftovers.
        find "$target" -xdev -depth -mindepth 1 -type d -print0 |
            xargs -0 -r -n "$dir_batch" -P "$workers" \
                rmdir --ignore-fail-on-non-empty --
        find "$target" -xdev -depth -mindepth 1 -type d -empty -delete
    fi

    if find "$target" -mindepth 1 -print -quit | grep -q .; then
        die "Target is not empty after parallel cleanup; refusing final removal: $target"
    fi

    rmdir -- "$target"
    printf '[%s] Removed directory: %s\n' "$(date -Iseconds)" "$target"
}

submit_main() {
    local dry_run=0 target_arg target submission_dir job_tag
    local sbatch_args=()
    local command=()

    while (($#)); do
        case "$1" in
            --dry-run)
                dry_run=1
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            --)
                shift
                break
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                break
                ;;
        esac
    done

    [[ $# -eq 1 ]] || die "Specify exactly one directory"
    [[ "$MY_RM_CPUS" =~ ^[1-9][0-9]*$ ]] || die "MY_RM_CPUS must be a positive integer"

    target_arg="$1"
    [[ ! -L "$target_arg" ]] || die "Refusing to remove a symbolic link: $target_arg"
    target="$(realpath -e -- "$target_arg")"
    submission_dir="$(pwd -P)"
    [[ "$target" != "$submission_dir" ]] || die "Refusing to remove the submission directory"
    validate_target "$target"

    mkdir -p "$MY_RM_LOG_DIR"
    MY_RM_LOG_DIR="$(cd "$MY_RM_LOG_DIR" && pwd -P)"
    [[ "$MY_RM_LOG_DIR" != "$target" && "$MY_RM_LOG_DIR" != "$target/"* ]] || \
        die "Log directory must be outside the removal target: $MY_RM_LOG_DIR"

    job_tag="$(safe_tag "$(basename "$target")")"
    job_tag="${job_tag:0:80}"

    sbatch_args=(
        "--job-name=rm_$job_tag"
        "--time=$MY_RM_TIME"
        "--ntasks=1"
        "--cpus-per-task=$MY_RM_CPUS"
        "--output=$MY_RM_LOG_DIR/my_rm.%j.log"
    )
    [[ -n "$MY_RM_PARTITION" ]] && sbatch_args+=("--partition=$MY_RM_PARTITION")
    command=(sbatch "${sbatch_args[@]}" "$SCRIPT_PATH" --worker "$target")

    printf 'Removal target: %s\n' "$target"
    if ((dry_run)); then
        printf 'Dry-run sbatch command:\n  '
        print_command "${command[@]}"
    else
        command -v sbatch >/dev/null || die "sbatch is required"
        "${command[@]}"
    fi
}

if [[ "${1:-}" == "--worker" ]]; then
    [[ $# -eq 2 ]] || die "Internal worker mode requires one target"
    worker_main "$2"
else
    submit_main "$@"
fi
